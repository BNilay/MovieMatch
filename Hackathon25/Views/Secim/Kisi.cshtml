@{
    ViewData["Title"] = "Kişi Sayısı";
}

<div class="kisi-wrapper">
    <div class="kisi-card shadow-sm">
        <h2 class="kisi-title">Kaç Kişisiniz?</h2>
        <p class="kisi-subtitle">Film zevkinizi birlikte analiz edelim 🎬</p>

        <form asp-action="Kisi" method="post" class="mt-4">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Kişi Sayısı</label>
                <input type="number"
                       name="kisiSayisi"
                       class="form-control form-control-lg"
                       min="1"
                       max="20"
                       placeholder="Örn: 4"
                       required />
                <div class="form-text">1 ile 20 arasında bir sayı giriniz.</div>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <button type="submit" class="btn btn-lg kisi-btn w-100">
                Devam Et →
            </button>
        </form>
    </div>
</div>
