@using System.Text.Json
@using Hackathon25.Services
@{
    ViewData["Title"] = "Sonuç";
    var kisiSayisi = TempData["KisiSayisi"]?.ToString() ?? "-";
    var filmListesi = TempData["FilmListesi"]?.ToString() ?? "";

    var aiAciklama = TempData["AI_Aciklama"]?.ToString() ?? "-";
    var aiOrtak = TempData["AI_OrtakTurler"]?.ToString() ?? "-";
    var aiUyumlu = TempData["AI_UyumluTurler"]?.ToString() ?? "-";
    var aiGerekce = TempData["AI_Gerekce"]?.ToString() ?? "-";

    var recJson = TempData["TMDB_Recs"] as string ?? "[]";
    var recs = JsonSerializer.Deserialize<List<TmdbMovie>>(recJson) ?? new();

    int pageVal = 1;
    int.TryParse(TempData["TMDB_Page"]?.ToString(), out pageVal);

    string PosterUrl(string? path)
        => string.IsNullOrWhiteSpace(path)
            ? "/images/poster-placeholder.png"  // İstersen ekle; yoksa alttaki placeholder div’i gösterebiliriz
            : $"https://image.tmdb.org/t/p/w342{path}";
}

<style>
    .result-wrap {
        max-width: 980px;
    }

    .hero-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        background: #ffffff;
    }

    .section-title {
        font-weight: 700;
        letter-spacing: .2px;
    }

    .pill {
        border-radius: 999px;
    }

    .movie-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(0,0,0,.06);
        overflow: hidden;
        height: 100%;
        background: #fff;
    }

    .poster {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        background: #f1f3f5;
    }

    .poster-fallback {
        width: 100%;
        aspect-ratio: 2/3;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #f1f3f5, #e9ecef);
        color: #6c757d;
        font-weight: 600;
    }

    .movie-title {
        font-weight: 700;
        margin-bottom: .25rem;
    }

    .movie-meta {
        font-size: .9rem;
        color: #6c757d;
    }

    .movie-overview {
        color: #495057;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-soft {
        background: #111827;
        color: #fff;
        border: 0;
        border-radius: 12px;
        padding: .6rem 1rem;
    }

        .btn-soft:hover {
            filter: brightness(.95);
            color: #fff;
        }

    .btn-outline-soft {
        border-radius: 12px;
        border: 1px solid #dee2e6;
    }

    .badge-soft {
        background: #f1f3f5;
        color: #343a40;
        border: 1px solid #e9ecef;
        font-weight: 600;
    }
</style>

<div class="container py-4 result-wrap">
    <!-- ÜST ÖZET -->
    <div class="card hero-card p-3 p-md-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h2 class="mb-1 section-title">Sonuç</h2>
                <div class="text-muted">Grup tercihlerini özetledim ve önerileri aşağıya sıraladım.</div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Kisi" class="btn btn-outline-soft">
                    ⬅ Başa dön
                </a>
                <form asp-action="BaskaOneriGetir" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="page" value="@pageVal" />
                    <button type="submit" class="btn btn-soft">
                        🔄 Başka öneri getir
                    </button>
                </form>
            </div>
        </div>

        <hr class="my-3" />

        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="p-3 rounded-4 bg-light">
                    <div class="text-muted small mb-1">Kişi sayısı</div>
                    <div class="fs-4 fw-bold">@kisiSayisi</div>
                </div>
            </div>

            <div class="col-12 col-md-8">
                <div class="p-3 rounded-4 bg-light">
                    <div class="text-muted small mb-1">Girilen filmler</div>

                    @if (string.IsNullOrWhiteSpace(filmListesi))
                    {
                        <div class="text-muted">Film listesi bulunamadı.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @{
                                // FilmListesi virgüllü / satırlı gelebilir diye basitçe parçalayalım
                                var parts = filmListesi
                                .Split(new[] { ",", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries)
                                .Select(x => x.Trim())
                                .Where(x => !string.IsNullOrWhiteSpace(x))
                                .Take(30)
                                .ToList();
                            }
                            @foreach (var p in parts)
                            {
                                <span class="badge badge-soft pill px-3 py-2">@p</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- AI ANALİZİ -->
    <div class="card hero-card p-3 p-md-4 mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <h3 class="mb-0 section-title">Gemini AI Analizi</h3>
            <span class="badge text-bg-light border">AI</span>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12">
                <div class="p-3 rounded-4 bg-light">
                    <div class="text-muted small mb-1">Açıklama</div>
                    <div>@aiAciklama</div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="p-3 rounded-4 bg-light h-100">
                    <div class="text-muted small mb-1">Ortak Türler</div>
                    <div>@aiOrtak</div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="p-3 rounded-4 bg-light h-100">
                    <div class="text-muted small mb-1">Uyumlu Türler</div>
                    <div>@aiUyumlu</div>
                </div>
            </div>

            <div class="col-12">
                <div class="p-3 rounded-4 bg-light">
                    <div class="text-muted small mb-1">Kısa Gerekçe</div>
                    <div>@aiGerekce</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TMDB ÖNERİLERİ -->
    <div class="d-flex align-items-end justify-content-between mb-2">
        <h3 class="section-title mb-0">Önerilen Filmler</h3>
        <div class="text-muted small">Kaynak: TMDB</div>
    </div>

    @if (!recs.Any())
    {
        <div class="card hero-card p-4">
            <div class="text-muted">Uygun öneri bulunamadı.</div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var m in recs)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="movie-card">
                        @* Poster *@
                        @if (!string.IsNullOrWhiteSpace(m.PosterPath))
                        {
                            <img class="poster" src="@PosterUrl(m.PosterPath)" alt="@m.Title poster" loading="lazy" />
                        }
                        else
                        {
                            <div class="poster-fallback">Poster yok</div>
                        }

                        <div class="p-3">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <div>
                                    <div class="movie-title">@m.Title</div>
                                    <div class="movie-meta">
                                        @(!string.IsNullOrWhiteSpace(m.ReleaseDate) ? m.ReleaseDate : "Tarih yok")
                                    </div>
                                </div>

                                <span class="badge text-bg-light border">
                                    ⭐ @m.VoteAverage
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(m.Overview))
                            {
                                <div class="movie-overview mt-2">@m.Overview</div>
                            }
                            else
                            {
                                <div class="text-muted mt-2">Açıklama bulunamadı.</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center mt-4">
            <form asp-action="BaskaOneriGetir" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="page" value="@pageVal" />
                <button type="submit" class="btn btn-soft px-4">
                    🔄 Başka öneri getir
                </button>
            </form>
        </div>
    }
</div>
